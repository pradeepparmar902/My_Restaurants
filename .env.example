# Tadka Restaurant Growth Platform - Environment Configuration
# Copy this file to .env.local for local development, or set in GitHub Actions / Vercel Environment Variables.

# Default Restaurant Slug (matches entry in public/config/restaurants.json)
NEXT_PUBLIC_DEFAULT_RESTAURANT_SLUG=tadka-truck

# Optional: Remote Google Drive / Cloud JSON Config File URL (for multi-tenant SaaS lookup)
NEXT_PUBLIC_REMOTE_CONFIG_JSON_URL=

# Google Workspace Storage Credentials (can be set per-deployment or via restaurants.json)
NEXT_PUBLIC_GOOGLE_APPS_SCRIPT_URL=
NEXT_PUBLIC_GOOGLE_SHEET_ID=
NEXT_PUBLIC_GOOGLE_DRIVE_FOLDER_ID=
